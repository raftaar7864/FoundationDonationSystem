@model FoundationDonationSystem.ViewModels.PaymentAccountViewModel
<div class="payment-popup-content">
    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="payment-create-error">
            <strong>
                Unable to create payment account.
            </strong>
            <ul>
                @foreach (var state in ViewData.ModelState)
                {
                    foreach (var error in state.Value.Errors)
                    {
                        if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                        {
                            <li>
                                @error.ErrorMessage
                            </li>
                        }
                    }
                }
            </ul>
        </div>
    }
    <form id="paymentAccountCreateForm"
          method="post"
          action="/admin/paymentaccounts/create"
          enctype="multipart/form-data"
          novalidate>
        @Html.AntiForgeryToken()
        <!-- BANK -->
        <div class="payment-form-grid">
            <div class="admin-form-group">
                <label for="createAccountName">
                    Account Name
                </label>
                <input type="text"
                       id="createAccountName"
                       name="AccountName"
                       class="admin-form-control"
                       value="@Model.AccountName" />
            </div>
            <div class="admin-form-group">
                <label for="createBankName">
                    Bank Name
                </label>
                <input type="text"
                       id="createBankName"
                       name="BankName"
                       class="admin-form-control"
                       value="@Model.BankName" />
            </div>
            <div class="admin-form-group">
                <label for="createAccountNumber">
                    Account Number
                </label>
                <input type="text"
                       id="createAccountNumber"
                       name="AccountNumber"
                       class="admin-form-control"
                       value="@Model.AccountNumber" />
            </div>
            <div class="admin-form-group">
                <label for="createIFSC">
                    IFSC Code
                </label>
                <input type="text"
                       id="createIFSC"
                       name="IFSC"
                       class="admin-form-control"
                       value="@Model.IFSC"
                       style="text-transform:uppercase;" />
            </div>
            <div class="admin-form-group">
                <label for="createBranch">
                    Branch
                </label>
                <input type="text"
                       id="createBranch"
                       name="Branch"
                       class="admin-form-control"
                       value="@Model.Branch" />
            </div>
            <div class="admin-form-group">
                <label for="createUpiId">
                    UPI ID
                </label>
                <input type="text"
                       id="createUpiId"
                       name="UpiId"
                       class="admin-form-control"
                       value="@Model.UpiId" />
            </div>
            <div class="admin-form-group">
                <label for="createQrCode">
                    QR Code
                </label>
                <input type="file"
                       id="createQrCode"
                       name="QrCode"
                       class="admin-form-control"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                <small class="admin-form-help">
                    JPG, JPEG, PNG or WEBP.
                    Maximum 1 MB.
                </small>
                @if (ViewData.ModelState["QrCode"]?.Errors.Count > 0)
                {
                    <div class="admin-field-error">
                        @ViewData.ModelState["QrCode"]!.Errors[0].ErrorMessage
                    </div>
                }
            </div>
        </div>
        <!-- QR PREVIEW -->
        <div id="createQrPreview"
             class="payment-popup-existing-qr"
             style="display:none;">
            <span>
                QR Preview
            </span>
            <img id="createQrPreviewImage"
                 src=""
                 alt="QR Code Preview" />
        </div>
        <!-- ACTIVE -->
        <div class="payment-active-box">
            <div class="payment-active-content">
                <strong>
                    Show on Donation Page
                </strong>
                <p>
                    Active payment accounts are displayed
                    to public donors.
                </p>
            </div>
            <label class="admin-switch">
                <input type="checkbox"
                       id="createIsActive"
                       name="IsActive"
                       value="true"
                @(Model.IsActive
                    ? "checked"
                    : "") />
                <span class="admin-switch-slider"></span>
                <span class="payment-active-label"
                      id="createStatusLabel">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </label>
            <input type="hidden"
                   name="IsActive"
                   value="false" />
        </div>
        <!-- ACTIONS -->
        <div class="payment-popup-actions">
            <button type="button"
                    class="admin-btn admin-btn-secondary"
                    onclick="closePaymentAccountModal()">
                Cancel
            </button>
            <button type="submit"
                    id="createPaymentAccountSubmit"
                    class="admin-btn admin-btn-primary">
                <span class="create-payment-account-button-text">
                    Create Payment Account
                </span>
                <span class="create-payment-account-button-loading"
                      style="display:none;">
                    Creating...
                </span>
            </button>
        </div>
    </form>
</div>
<script>
    (function () {
        const form =
            document.getElementById(
                "paymentAccountCreateForm"
            );
        if (!form) {
            return;
        }
        /*
         * Prevent duplicate event binding
         */
        if (form.dataset.initialized === "true") {
            return;
        }
        form.dataset.initialized = "true";
        /*
         * IFSC UPPERCASE
         */
        const ifsc =
            document.getElementById(
                "createIFSC"
            );
        if (ifsc) {
            ifsc.addEventListener(
                "input",
                function () {
                    this.value =
                        this.value.toUpperCase();
                }
            );
        }
        /*
         * ACTIVE / INACTIVE LABEL
         */
        const activeCheckbox =
            document.getElementById(
                "createIsActive"
            );
        const statusLabel =
            document.getElementById(
                "createStatusLabel"
            );
        if (activeCheckbox && statusLabel) {
            activeCheckbox.addEventListener(
                "change",
                function () {
                    statusLabel.textContent =
                        this.checked
                            ? "Active"
                            : "Inactive";
                }
            );
        }
        /*
         * QR PREVIEW
         */
        const qrInput =
            document.getElementById(
                "createQrCode"
            );
        const qrPreview =
            document.getElementById(
                "createQrPreview"
            );
        const qrPreviewImage =
            document.getElementById(
                "createQrPreviewImage"
            );
        if (
            qrInput &&
            qrPreview &&
            qrPreviewImage
        ) {
            qrInput.addEventListener(
                "change",
                function () {
                    const file =
                        this.files &&
                        this.files.length > 0
                            ? this.files[0]
                            : null;
                    if (!file) {
                        qrPreview.style.display =
                            "none";
                        qrPreviewImage.src = "";
                        return;
                    }
                    const allowedTypes = [
                        "image/jpeg",
                        "image/png",
                        "image/webp"
                    ];
                    if (
                        !allowedTypes.includes(
                            file.type
                        )
                    ) {
                        qrPreview.style.display =
                            "none";
                        qrPreviewImage.src = "";
                        return;
                    }
                    if (
                        file.size >
                        1 * 1024 * 1024
                    ) {
                        qrPreview.style.display =
                            "none";
                        qrPreviewImage.src = "";
                        return;
                    }
                    const reader =
                        new FileReader();
                    reader.onload =
                        function (event) {
                            qrPreviewImage.src =
                                event.target.result;
                            qrPreview.style.display =
                                "block";
                        };
                    reader.readAsDataURL(file);
                }
            );
        }
        /*
         * FORM SUBMIT
         */
        form.addEventListener(
            "submit",
            function (event) {
                event.preventDefault();
                submitPaymentAccountCreate(
                    form
                );
            }
        );
    })();
    /*
     * =============================================================
     * AJAX CREATE
     * =============================================================
     */
    async function submitPaymentAccountCreate(form) {
        const submitButton =
            document.getElementById(
                "createPaymentAccountSubmit"
            );
        if (!submitButton) {
            return;
        }
        const normalText =
            submitButton.querySelector(
                ".create-payment-account-button-text"
            );
        const loadingText =
            submitButton.querySelector(
                ".create-payment-account-button-loading"
            );
        submitButton.disabled = true;
        if (normalText) {
            normalText.style.display =
                "none";
        }
        if (loadingText) {
            loadingText.style.display =
                "inline";
        }
        try {
            const formData =
                new FormData(form);
            const response =
                await fetch(
                    form.action,
                    {
                        method: "POST",
                        body: formData,
                        headers: {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    }
                );
            const contentType =
                response.headers.get(
                    "content-type"
                ) || "";
            /*
             * SUCCESS JSON
             */
            if (
                contentType.includes(
                    "application/json"
                )
            ) {
                const result =
                    await response.json();
                if (result.success) {
                    closePaymentAccountModal();
                    /*
                     * Reload the index so the
                     * newly created payment
                     * account appears immediately.
                     */
                    window.location.href =
                        "/admin/paymentaccounts";
                    return;
                }
                showPaymentAccountModalError(
                    result.message ||
                    "Unable to create payment account."
                );
                return;
            }
            /*
             * VALIDATION ERROR
             */
            const html =
                await response.text();
            const modalBody =
                document.querySelector(
                    "#paymentAccountModalBody"
                );
            if (modalBody) {
                modalBody.innerHTML =
                    html;
                /*
                 * Re-execute scripts inserted
                 * through innerHTML.
                 */
                executePaymentAccountModalScripts(
                    modalBody
                );
            }
        }
        catch (error) {
            console.error(
                "Payment account create error:",
                error
            );
            showPaymentAccountModalError(
                "Unable to create payment account. Please try again."
            );
        }
        finally {
            /*
             * Only enable again if the modal
             * is still open.
             */
            if (
                document.body.classList.contains(
                    "payment-account-modal-open"
                )
            ) {
                submitButton.disabled =
                    false;
                if (normalText) {
                    normalText.style.display =
                        "inline";
                }
                if (loadingText) {
                    loadingText.style.display =
                        "none";
                }
            }
        }
    }
    /*
     * =============================================================
     * ERROR DISPLAY
     * =============================================================
     */
    function showPaymentAccountModalError(message) {
        const modalBody =
            document.querySelector(
                "#paymentAccountModalBody"
            );
        if (!modalBody) {
            return;
        }
        modalBody.innerHTML = `
            <div class="payment-account-modal-error">
                <div style="font-size:24px;margin-bottom:8px;">
                    !
                </div>
                <div>
                    ${escapeHtml(message)}
                </div>
                <div style="margin-top:15px;">
                    <button type="button"
                            class="admin-btn admin-btn-secondary"
                            onclick="closePaymentAccountModal()">
                        Close
                    </button>
                </div>
            </div>
        `;
    }
    /*
     * =============================================================
     * EXECUTE SCRIPTS AFTER PARTIAL RELOAD
     * =============================================================
     */
    function executePaymentAccountModalScripts(container) {
        const scripts =
            container.querySelectorAll(
                "script"
            );
        scripts.forEach(
            function (oldScript) {
                const newScript =
                    document.createElement(
                        "script"
                    );
                Array.from(
                    oldScript.attributes
                ).forEach(
                    function (attribute) {
                        newScript.setAttribute(
                            attribute.name,
                            attribute.value
                        );
                    }
                );
                newScript.textContent =
                    oldScript.textContent;
                oldScript.parentNode.replaceChild(
                    newScript,
                    oldScript
                );
            }
        );
    }
</script>