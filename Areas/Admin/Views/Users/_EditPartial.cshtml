@model FoundationDonationSystem.ViewModels.UserEditViewModel
<div class="payment-popup-content">
    <!-- =========================================================
         VALIDATION SUMMARY
         ========================================================= -->
    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="admin-validation-summary">
            @Html.ValidationSummary(
                false,
                "",
                new
                {
                    @class = "admin-validation-list"
                })
        </div>
    }
    <!-- =========================================================
         EDIT USER FORM
         ========================================================= -->
    <form id="userEditForm"
          method="post"
          action="/admin/users/edit/@Model.Id">
        @Html.AntiForgeryToken()
        <input asp-for="Id"
               type="hidden" />
        <!-- =====================================================
             USER INFORMATION
             ===================================================== -->
        <div class="payment-form-grid">
            <!-- FULL NAME -->
            <div class="admin-form-group">
                <label asp-for="FullName"
                       class="admin-form-label">
                    Full Name
                    <span>*</span>
                </label>
                <input asp-for="FullName"
                       class="admin-form-control"
                       placeholder="Enter full name"
                       autocomplete="name"
                       maxlength="150" />
                <span asp-validation-for="FullName"
                      class="field-validation">
                </span>
            </div>
            <!-- DESIGNATION -->
            <div class="admin-form-group">
                <label asp-for="Designation"
                       class="admin-form-label">
                    Designation
                </label>
                <input asp-for="Designation"
                       class="admin-form-control"
                       placeholder="Enter designation"
                       maxlength="150"
                       autocomplete="organization-title" />
                <span asp-validation-for="Designation"
                      class="field-validation">
                </span>
            </div>
            <!-- USERNAME -->
            <div class="admin-form-group">
                <label asp-for="UserName"
                       class="admin-form-label">
                    Username
                    <span>*</span>
                </label>
                <input asp-for="UserName"
                       class="admin-form-control"
                       placeholder="Enter username"
                       autocomplete="username"
                       maxlength="50" />
                <span asp-validation-for="UserName"
                      class="field-validation">
                </span>
            </div>
            <!-- EMAIL -->
            <div class="admin-form-group">
                <label asp-for="Email"
                       class="admin-form-label">
                    Email
                </label>
                <input asp-for="Email"
                       type="email"
                       class="admin-form-control"
                       placeholder="Enter email address"
                       autocomplete="email"
                       maxlength="200" />
                <span asp-validation-for="Email"
                      class="field-validation">
                </span>
            </div>
            <!-- PHONE -->
            <div class="admin-form-group">
                <label asp-for="PhoneNumber"
                       class="admin-form-label">
                    Phone Number
                </label>
                <input asp-for="PhoneNumber"
                       type="tel"
                       class="admin-form-control"
                       placeholder="Enter phone number"
                       autocomplete="tel"
                       maxlength="30" />
                <span asp-validation-for="PhoneNumber"
                      class="field-validation">
                </span>
            </div>
            <!-- ROLE -->
            <div class="admin-form-group">
                <label asp-for="Role"
                       class="admin-form-label">
                    Role
                    <span>*</span>
                </label>
                <select asp-for="Role"
                        class="admin-form-control">
                    <option value="@FoundationDonationSystem.Models.Enums.UserRole.DonationVerifier">
                        Donation Verifier
                    </option>
                    <option value="@FoundationDonationSystem.Models.Enums.UserRole.Administrator">
                        Administrator
                    </option>
                </select>
                <span asp-validation-for="Role"
                      class="field-validation">
                </span>
            </div>
        </div>
        <!-- =====================================================
             ACCOUNT STATUS
             ===================================================== -->
        <div class="payment-active-box"
             style="margin-top:15px;">
            <label class="admin-switch">
                <input asp-for="IsActive"
                       id="editIsActive"
                       type="checkbox" />
                <span></span>
            </label>
            <div>
                <div class="payment-active-label"
                     id="editActiveLabel">
                    @(Model.IsActive
                        ? "Active"
                        : "Inactive")
                </div>
                <div style="
                    margin-top:2px;
                    color:#6b7280;
                    font-size:10px;
                    line-height:1.4;">
                    Active users can access the administration system.
                </div>
            </div>
        </div>
        <!-- =====================================================
             PASSWORD
             ===================================================== -->
        <div class="payment-form-grid"
             style="margin-top:15px;">
            <div class="admin-form-group">
                <label asp-for="NewPassword"
                       class="admin-form-label">
                    New Password
                </label>
                <input asp-for="NewPassword"
                       type="password"
                       class="admin-form-control"
                       placeholder="Leave blank to keep current password"
                       autocomplete="new-password" />
                <span asp-validation-for="NewPassword"
                      class="field-validation">
                </span>
            </div>
            <div class="admin-form-group">
                <label asp-for="ConfirmNewPassword"
                       class="admin-form-label">
                    Confirm New Password
                </label>
                <input asp-for="ConfirmNewPassword"
                       type="password"
                       class="admin-form-control"
                       placeholder="Confirm new password"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword"
                      class="field-validation">
                </span>
            </div>
        </div>
        <!-- =====================================================
             CREATED INFORMATION
             ===================================================== -->
        <div class="payment-detail-grid">
            <div class="payment-detail-item">
                <label>
                    Created At
                </label>
                <strong>
                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                </strong>
            </div>
            <div class="payment-detail-item">
                <label>
                    User ID
                </label>
                <strong>
                    @Model.Id
                </strong>
            </div>
        </div>
        <!-- =====================================================
             ACTIONS
             ===================================================== -->
        <div class="payment-popup-actions">
            <button type="button"
                    class="admin-btn admin-btn-secondary"
                    onclick="closeUserModal()">
                Cancel
            </button>
            <button type="submit"
                    id="userEditSubmit"
                    class="admin-btn admin-btn-primary">
                <span id="userEditSubmitText">
                    Save Changes
                </span>
                <span id="userEditSubmitLoading"
                      style="display:none;">
                    Saving...
                </span>
            </button>
        </div>
    </form>
</div>
<script>
    (function() {
        const form =
            document.getElementById(
                "userEditForm"
            );
        if (!form) {
            return;
        }
        if (
            form.dataset.initialized ===
            "true"
        ) {
            return;
        }
        form.dataset.initialized =
            "true";
        /* =========================================================
           ACTIVE LABEL
           ========================================================= */
        const checkbox =
            document.getElementById(
                "editIsActive"
            );
        const label =
            document.getElementById(
                "editActiveLabel"
            );
        if (
            checkbox &&
            label
        ) {
            checkbox.addEventListener(
                "change",
                function() {
                    label.textContent =
                        this.checked
                            ? "Active"
                            : "Inactive";
                }
            );
        }
        /* =========================================================
           SUBMIT
           ========================================================= */
        form.addEventListener(
            "submit",
            function(event) {
                event.preventDefault();
                submitUserEdit(
                    form
                );
            }
        );
    })();
    /* =============================================================
       AJAX EDIT
       ============================================================= */
    async function submitUserEdit(
        form
    ) {
        const button =
            document.getElementById(
                "userEditSubmit"
            );
        const normalText =
            document.getElementById(
                "userEditSubmitText"
            );
        const loadingText =
            document.getElementById(
                "userEditSubmitLoading"
            );
        if (!button) {
            return;
        }
        button.disabled = true;
        if (normalText) {
            normalText.style.display =
                "none";
        }
        if (loadingText) {
            loadingText.style.display =
                "inline";
        }
        try {
            const response =
                await fetch(
                    form.action,
                    {
                        method: "POST",
                        body:
                            new FormData(form),
                        headers: {
                            "X-Requested-With":
                                "XMLHttpRequest",
                            "Accept":
                                "text/html, application/json"
                        }
                    }
                );
            const contentType =
                response.headers.get(
                    "content-type"
                ) || "";
            /* -----------------------------------------------------
               SUCCESS
               ----------------------------------------------------- */
            if (
                contentType.includes(
                    "application/json"
                )
            ) {
                const result =
                    await response.json();
                if (result.success) {
                    closeUserModal();
                    window.location.href =
                        "/admin/users";
                    return;
                }
                throw new Error(
                    result.message ||
                    "Unable to update user."
                );
            }
            /* -----------------------------------------------------
               VALIDATION RESPONSE
               ----------------------------------------------------- */
            const html =
                await response.text();
            const body =
                document.getElementById(
                    "userModalBody"
                );
            if (body) {
                body.innerHTML =
                    html;
                executeUserModalScripts(
                    body
                );
            }
        }
        catch (error) {
            console.error(
                "Edit user error:",
                error
            );
            const body =
                document.getElementById(
                    "userModalBody"
                );
            if (body) {
                body.innerHTML = `
                    <div class="payment-account-modal-error">
                        <strong>
                            Unable to update user
                        </strong>
                        <p>
                            ${escapeHtml(
                    error.message ||
                    "Something went wrong."
                )}
                        </p>
                        <button type="button"
                                class="admin-btn admin-btn-secondary"
                                onclick="closeUserModal()">
                            Close
                        </button>
                    </div>
                `;
            }
        }
        finally {
            if (
                document.body.classList.contains(
                    "user-modal-open"
                )
            ) {
                button.disabled =
                    false;
                if (normalText) {
                    normalText.style.display =
                        "inline";
                }
                if (loadingText) {
                    loadingText.style.display =
                        "none";
                }
            }
        }
    }
</script>