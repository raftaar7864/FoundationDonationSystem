@model FoundationDonationSystem.ViewModels.UserDetailsViewModel
<div class="payment-popup-content">
    <!-- =========================================================
         USER DETAILS
         ========================================================= -->
    <div class="payment-detail-grid">
        <!-- FULL NAME -->
        <div class="payment-detail-item">
            <label>
                Full Name
            </label>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.FullName)
                    ? "—"
                    : Model.FullName)
            </strong>
        </div>
        <!-- DESIGNATION -->
        <div class="payment-detail-item">
            <label>
                Designation
            </label>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.Designation)
                    ? "—"
                    : Model.Designation)
            </strong>
        </div>
        <!-- USERNAME -->
        <div class="payment-detail-item">
            <label>
                Username
            </label>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.UserName)
                    ? "—"
                    : Model.UserName)
            </strong>
        </div>
        <!-- EMAIL -->
        <div class="payment-detail-item">
            <label>
                Email
            </label>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.Email)
                    ? "—"
                    : Model.Email)
            </strong>
        </div>
        <!-- PHONE -->
        <div class="payment-detail-item">
            <label>
                Phone Number
            </label>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                    ? "—"
                    : Model.PhoneNumber)
            </strong>
        </div>
        <!-- ROLE -->
        <div class="payment-detail-item">
            <label>
                Role
            </label>
            <strong>
                @if (string.Equals(
                    Model.Role,
                    FoundationDonationSystem.Models.Enums.UserRole.Administrator,
                    StringComparison.OrdinalIgnoreCase))
                {
                    <span class="admin-status-badge status-verified">
                        Administrator
                    </span>
                }
                else
                {
                    <span class="admin-status-badge status-pending">
                        Donation Verifier
                    </span>
                }
            </strong>
        </div>
        <!-- STATUS -->
        <div class="payment-detail-item">
            <label>
                Status
            </label>
            <strong>
                @if (Model.IsActive)
                {
                    <span class="admin-status-badge status-verified">
                        Active
                    </span>
                }
                else
                {
                    <span class="admin-status-badge status-rejected">
                        Inactive
                    </span>
                }
            </strong>
        </div>
        <!-- CREATED -->
        <div class="payment-detail-item">
            <label>
                Created At
            </label>
            <strong>
                @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
            </strong>
        </div>
        <!-- USER ID -->
        <div class="payment-detail-item"
             style="grid-column:1 / -1;">
            <label>
                User ID
            </label>
            <strong>
                @Model.Id
            </strong>
        </div>
    </div>
    <!-- =========================================================
         ACTIONS
         ========================================================= -->
    <div class="payment-popup-actions">
        <button type="button"
                class="admin-btn admin-btn-secondary"
                onclick="closeUserModal()">
            Close
        </button>
    </div>
</div>