@model IEnumerable<FoundationDonationSystem.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "Users";
    var users = Model?.ToList()
        ?? new List<FoundationDonationSystem.ViewModels.UserListViewModel>();
}
<div class="admin-page users-page">
    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->
    <div class="admin-page-header users-header">
        <div>
            <h1>
                Users
            </h1>
            <p>
                Manage administrator and donation verifier accounts.
            </p>
        </div>
        <div class="users-header-actions">
            <button type="button"
                    class="admin-btn admin-btn-primary"
                    onclick="openUserModal(
                '/admin/users/create',
                'Create User')">
                Create User
            </button>
        </div>
    </div>
    <!-- =========================================================
         SUCCESS MESSAGE
         ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    <!-- =========================================================
         USERS TABLE CARD
         ========================================================= -->
    <div class="admin-table-card users-card">
        <div class="admin-table-header users-card-header">
            <div class="settings-card-title">
                Users
            </div>
            <div>
                <span class="admin-badge admin-badge-primary">
                    @users.Count
                    @(users.Count == 1 ? "User" : "Users")
                </span>
            </div>
        </div>
        @if (!users.Any())
        {
            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->
            <div class="admin-empty-state users-empty-state">
                <div class="admin-empty-state-icon">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" />
                    </svg>
                </div>
                <strong>
                    No users found
                </strong>
                <span>
                    Create a user account to get started.
                </span>
            </div>
        }
        else
        {
            <!-- =================================================
                 USER CARDS
                 ================================================= -->
            <div class="users-grid">
                @foreach (var user in users)
                {
                    var displayName =
                        string.IsNullOrWhiteSpace(user.FullName)
                            ? "User"
                            : user.FullName.Trim();
                    var initial =
                        displayName.Substring(0, 1).ToUpperInvariant();
                    var isAdministrator =
                        string.Equals(
                            user.Role,
                            FoundationDonationSystem.Models.Enums.UserRole.Administrator,
                            StringComparison.OrdinalIgnoreCase);
                    <article class="user-card">
                        <div class="user-card-top">
                            <div class="users-user-cell">
                                <div class="users-user-avatar">
                                    @initial
                                </div>
                                <div class="users-user-info">
                                    <strong>@displayName</strong>
                                    @if (!string.IsNullOrWhiteSpace(user.Designation))
                                    {
                                        <span>@user.Designation</span>
                                    }
                                </div>
                            </div>
                            <div class="user-card-status">
                                @if (user.IsActive)
                                {
                                    <span class="admin-status-badge status-verified">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-status-badge status-rejected">
                                        Inactive
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="user-card-divider"></div>
                        <div class="user-card-details">
                            <div class="user-card-detail">
                                <span class="user-card-label">Username</span>
                                <strong>
                                    @(string.IsNullOrWhiteSpace(user.UserName)
                                        ? "—"
                                        : user.UserName)
                                </strong>
                            </div>
                            <div class="user-card-detail">
                                <span class="user-card-label">Email</span>
                                <strong class="user-card-value-wrap">
                                    @(string.IsNullOrWhiteSpace(user.Email)
                                        ? "—"
                                        : user.Email)
                                </strong>
                            </div>
                            <div class="user-card-detail">
                                <span class="user-card-label">Phone</span>
                                <strong>
                                    @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                        ? "—"
                                        : user.PhoneNumber)
                                </strong>
                            </div>
                            <div class="user-card-detail">
                                <span class="user-card-label">Role</span>
                                @if (isAdministrator)
                                {
                                    <span class="admin-status-badge status-verified">
                                        Administrator
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-status-badge status-pending">
                                        Donation Verifier
                                    </span>
                                }
                            </div>
                            <div class="user-card-detail">
                                <span class="user-card-label">Created</span>
                                <strong>
                                    @user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </strong>
                            </div>
                        </div>
                        <div class="user-card-actions">
                            <button type="button"
                                    class="admin-btn admin-btn-secondary admin-btn-sm"
                                    onclick="openUserModal(
                                        '/admin/users/details/@user.Id',
                                        'User Details')">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 5c5.2 0 9 7 9 7s-3.8 7-9 7-9-7-9-7 3.8-7 9-7Z"></path>
                                    <circle cx="12" cy="12" r="2.5"></circle>
                                </svg>
                                <span>Details</span>
                            </button>
                            <button type="button"
                                    class="admin-btn admin-btn-primary admin-btn-sm"
                                    onclick="openUserModal(
                                        '/admin/users/edit/@user.Id',
                                        'Edit User')">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                                </svg>
                                <span>Edit</span>
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
<!-- =============================================================
     USER MODAL
     ============================================================= -->
<div id="userModal"
     class="payment-account-modal"
     aria-hidden="true">
    <div class="payment-account-modal-overlay"
         onclick="closeUserModal()">
    </div>
    <div class="payment-account-modal-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="userModalTitle">
        <div class="payment-account-modal-header">
            <div>
                <h2 id="userModalTitle">
                    User
                </h2>
            </div>
            <button type="button"
                    class="payment-account-modal-close"
                    onclick="closeUserModal()"
                    aria-label="Close">
                &times;
            </button>
        </div>
        <div id="userModalBody"
             class="payment-account-modal-body">
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        /* =========================================================
           USER MODAL HELPERS
           ========================================================= */
        function getUserModal() {
            return document.getElementById("userModal");
        }
        function getUserModalBody() {
            return document.getElementById("userModalBody");
        }
        function getUserModalTitle() {
            return document.getElementById("userModalTitle");
        }
        /* =========================================================
           OPEN USER MODAL
           ========================================================= */
        async function openUserModal(url, title) {
            const modal =
                getUserModal();
            const modalBody =
                getUserModalBody();
            const modalTitle =
                getUserModalTitle();
            if (!modal || !modalBody) {
                console.error(
                    "User modal elements not found."
                );
                return;
            }
            if (modalTitle) {
                modalTitle.textContent =
                    title || "User";
            }
            /* -----------------------------------------------------
               LOADING
               ----------------------------------------------------- */
            modalBody.innerHTML = `
                        <div class="payment-account-modal-loading">
                            <div class="payment-account-spinner"></div>
                            <span>
                                Loading...
                            </span>
                        </div>
                    `;
            /* -----------------------------------------------------
               SHOW MODAL
               ----------------------------------------------------- */
            modal.classList.add("show");
            modal.setAttribute(
                "aria-hidden",
                "false"
            );
            document.body.classList.add(
                "payment-account-modal-open"
            );
            document.body.classList.add(
                "user-modal-open"
            );
            /* -----------------------------------------------------
               LOAD CONTENT
               ----------------------------------------------------- */
            try {
                const response =
                    await fetch(
                        url,
                        {
                            method: "GET",
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest",
                                "Accept":
                                    "text/html"
                            }
                        }
                    );
                const html =
                    await response.text();
                if (!response.ok) {
                    throw new Error(
                        html ||
                        "Unable to load user."
                    );
                }
                modalBody.innerHTML =
                    html;
                executeUserModalScripts(
                    modalBody
                );
            }
            catch (error) {
                console.error(
                    "User modal error:",
                    error
                );
                modalBody.innerHTML = `
                            <div class="payment-account-modal-error">
                                <strong>
                                    Unable to load user
                                </strong>
                                <p>
                                    ${escapeHtml(
                    error.message ||
                    "Something went wrong."
                )}
                                </p>
                            </div>
                        `;
            }
        }
        /* =========================================================
           CLOSE USER MODAL
           ========================================================= */
        function closeUserModal() {
            const modal =
                getUserModal();
            if (!modal) {
                return;
            }
            modal.classList.remove(
                "show"
            );
            modal.setAttribute(
                "aria-hidden",
                "true"
            );
            document.body.classList.remove(
                "payment-account-modal-open"
            );
            document.body.classList.remove(
                "user-modal-open"
            );
            const modalBody =
                getUserModalBody();
            if (modalBody) {
                modalBody.innerHTML =
                    "";
            }
        }
        /* =========================================================
           ESCAPE KEY
           ========================================================= */
        document.addEventListener(
            "keydown",
            function(event) {
                if (event.key !== "Escape") {
                    return;
                }
                const modal =
                    getUserModal();
                if (
                    modal &&
                    modal.classList.contains("show")
                ) {
                    closeUserModal();
                }
            }
        );
        /* =========================================================
           EXECUTE PARTIAL SCRIPTS
           ========================================================= */
        function executeUserModalScripts(
            container
        ) {
            if (!container) {
                return;
            }
            const scripts =
                container.querySelectorAll(
                    "script"
                );
            scripts.forEach(
                function(oldScript) {
                    const newScript =
                        document.createElement(
                            "script"
                        );
                    if (oldScript.src) {
                        newScript.src =
                            oldScript.src;
                    }
                    else {
                        newScript.textContent =
                            oldScript.textContent;
                    }
                    document.body.appendChild(
                        newScript
                    );
                    oldScript.remove();
                }
            );
        }
        /* =========================================================
           HTML ESCAPE
           ========================================================= */
        function escapeHtml(value) {
            const div =
                document.createElement(
                    "div"
                );
            div.textContent =
                value ?? "";
            return div.innerHTML;
        }
        /* =========================================================
           INITIALIZE
           ========================================================= */
        document.addEventListener(
            "DOMContentLoaded",
            function() {
                const modal =
                    getUserModal();
                if (modal) {
                    modal.classList.remove(
                        "show"
                    );
                    modal.setAttribute(
                        "aria-hidden",
                        "true"
                    );
                }
            }
        );
    </script>
}