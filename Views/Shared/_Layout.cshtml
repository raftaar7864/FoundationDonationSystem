@using FoundationDonationSystem.Models
@inject FoundationDonationSystem.Services.IFoundationSettingsService FoundationSettingsService
@{
    var foundationSettings = await FoundationSettingsService.GetAsync();

    // =========================================================
    // SEO META DETAILS
    // =========================================================
    var seoTitle =
        ViewData["SeoTitle"]?.ToString()
        ?? ViewData["Title"]?.ToString()
        ?? foundationSettings.FoundationName;

    var seoDescription =
        ViewData["SeoDescription"]?.ToString()
        ?? $"{foundationSettings.FoundationName} - Working together to create a better future and make a meaningful difference in our community.";

    var seoKeywords =
        ViewData["SeoKeywords"]?.ToString()
        ?? $"{foundationSettings.FoundationName}, foundation, charity, donation, community development, social work, nonprofit";

    var seoImage =
        ViewData["SeoImage"]?.ToString()
        ?? foundationSettings.LogoPath
        ?? "~/images/foundation-logo.png";

    var seoCanonical =
        ViewData["SeoCanonical"]?.ToString()
        ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}";

    if (seoImage.StartsWith("~/"))
    {
        seoImage = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Url.Content(seoImage)}";
    }
    else if (seoImage.StartsWith("/"))
    {
        seoImage = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{seoImage}";
    }
}
@{
    var controllerName =
        ViewContext.RouteData.Values["controller"]?.ToString()
        ?? string.Empty;
    var actionName =
        ViewContext.RouteData.Values["action"]?.ToString()
        ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>@seoTitle | @foundationSettings.FoundationName</title>

    <!-- =====================================================
         SEO META DETAILS
         ===================================================== -->
    <meta name="description"
          content="@seoDescription" />
    <meta name="keywords"
          content="@seoKeywords" />
    <meta name="author"
          content="@foundationSettings.FoundationName" />
    <meta name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot"
          content="index, follow" />
    <meta name="bingbot"
          content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical"
          href="@seoCanonical" />

    <!-- =====================================================
         OPEN GRAPH / SOCIAL SHARING
         ===================================================== -->
    <meta property="og:type"
          content="website" />
    <meta property="og:site_name"
          content="@foundationSettings.FoundationName" />
    <meta property="og:title"
          content="@seoTitle" />
    <meta property="og:description"
          content="@seoDescription" />
    <meta property="og:url"
          content="@seoCanonical" />
    <meta property="og:image"
          content="@seoImage" />
    <meta property="og:image:alt"
          content="@foundationSettings.FoundationName" />
    <meta property="og:locale"
          content="en_IN" />

    <!-- =====================================================
         TWITTER / X CARD
         ===================================================== -->
    <meta name="twitter:card"
          content="summary_large_image" />
    <meta name="twitter:title"
          content="@seoTitle" />
    <meta name="twitter:description"
          content="@seoDescription" />
    <meta name="twitter:image"
          content="@seoImage" />
    <meta name="twitter:image:alt"
          content="@foundationSettings.FoundationName" />

    <!-- =====================================================
         ADDITIONAL SEO / BROWSER DETAILS
         ===================================================== -->
    <meta name="theme-color"
          content="#ea580c" />
    <meta name="application-name"
          content="@foundationSettings.FoundationName" />
    <meta name="apple-mobile-web-app-title"
          content="@foundationSettings.FoundationName" />
    <meta name="format-detection"
          content="telephone=no" />
    <script type="importmap"></script>
    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- =====================================================
         SITE CSS
         ===================================================== -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-posts.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/FoundationDonationSystem.styles.css"
          asp-append-version="true" />
    @await RenderSectionAsync(
        "Styles",
        required: false)
    <!-- =====================================================
         STRUCTURED DATA — ORGANIZATION
         ===================================================== -->
    <script type="application/ld+json">
            {
                "@@context": "https://schema.org",
                "@@type": "Organization",
                "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(foundationSettings.FoundationName)),
                "url": @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/")),
                "logo": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(seoImage)),
                "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(seoDescription))
            }
    </script>
</head>
<body>
    <!-- =====================================================
         PUBLIC HEADER
         ===================================================== -->
    <header class="public-header">
        <nav class="public-navbar">
            <div class="public-container">
                <!-- =================================================
                     BRAND
                     ================================================= -->
                <a class="foundation-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="foundation-brand-mark">
                        @if (!string.IsNullOrWhiteSpace(
                            foundationSettings.LogoPath))
                        {
                            <img src="@foundationSettings.LogoPath"
                                 alt="@foundationSettings.FoundationName" />
                        }
                        else
                        {
                            <img src="~/images/foundation-logo.png"
                                 alt="@foundationSettings.FoundationName" />
                        }
                    </span>
                    <span class="foundation-brand-content">
                        <span class="foundation-brand-name">
                            @foundationSettings.FoundationName
                        </span>
                        <span class="foundation-brand-subtitle">
                            @foundationSettings.Tagline
                        </span>
                    </span>
                </a>
                <!-- =================================================
                     MOBILE MENU BUTTON
                     ================================================= -->
                <button class="public-menu-toggle"
                        type="button"
                        aria-label="Toggle navigation"
                        aria-expanded="false"
                        aria-controls="publicNavigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <!-- =================================================
                     NAVIGATION
                     ================================================= -->
                <div class="public-navigation"
                     id="publicNavigation">
                    <div class="public-nav-links">
                        <!-- HOME -->
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           class="public-nav-link @(controllerName.Equals("Home", StringComparison.OrdinalIgnoreCase) && actionName.Equals("Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="bi bi-house-door-fill"
                               aria-hidden="true"></i>
                            <span>Home</span>
                        </a>
                        <!-- OUR WORK -->
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Causes"
                           class="public-nav-link @(controllerName.Equals("Home", StringComparison.OrdinalIgnoreCase) && actionName.Equals("Causes", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="bi bi-heart-fill"
                               aria-hidden="true"></i>
                            <span>Our Work</span>
                        </a>
                        <!-- UPDATES -->
                        <a asp-area=""
                           asp-controller="Posts"
                           asp-action="Index"
                           class="public-nav-link @(controllerName.Equals("Posts", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="bi bi-newspaper"
                               aria-hidden="true"></i>
                            <span>Updates</span>
                        </a>
                        <!-- DONATION STATUS -->
                        <a asp-area=""
                           asp-controller="DonationStatus"
                           asp-action="Index"
                           class="public-nav-link @(controllerName.Equals("DonationStatus", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="bi bi-search-heart-fill"
                               aria-hidden="true"></i>
                            <span>Donation Status</span>
                        </a>
                    </div>
                    <!-- =================================================
                         DONATE BUTTON
                         ================================================= -->
                    <a class="public-donate-button"
                       asp-area=""
                       asp-controller="Donation"
                       asp-action="Index">
                        <span class="public-donate-icon">
                            <i class="bi bi-heart-fill"
                               aria-hidden="true"></i>
                        </span>
                        <span>Donate Now</span>
                    </a>
                    <!-- =================================================
                         HEADER ACTIONS
                         ================================================= -->
                    <div class="public-nav-actions">
                        <!-- LANGUAGE -->
                        <div class="public-language-selector">
                            <button type="button"
                                    class="public-language-button"
                                    id="publicLanguageButton"
                                    aria-haspopup="true"
                                    aria-expanded="false">
                                <i class="bi bi-translate"
                                   aria-hidden="true"></i>
                                <span id="publicLanguageLabel">
                                    English
                                </span>
                                <i class="bi bi-chevron-down public-language-chevron"
                                   aria-hidden="true"></i>
                            </button>
                            <div class="public-language-menu"
                                 id="publicLanguageMenu"
                                 role="menu"
                                 aria-hidden="true">
                                <button type="button"
                                        class="public-language-option active"
                                        data-language="en"
                                        role="menuitem">
                                    <span>English</span>
                                </button>
                                <button type="button"
                                        class="public-language-option"
                                        data-language="bn"
                                        role="menuitem">
                                    <span>বাংলা</span>
                                </button>
                                <button type="button"
                                        class="public-language-option"
                                        data-language="hi"
                                        role="menuitem">
                                    <span>हिन्दी</span>
                                </button>
                            </div>
                        </div>
                        <!-- =================================================
                             ADMIN / DASHBOARD
                             ================================================= -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Administrator") ||
                                User.IsInRole("DonationVerifier"))
                            {
                                <a class="public-login-button"
                                   asp-area="Admin"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="bi bi-speedometer2"
                                       aria-hidden="true"></i>
                                    <span>Dashboard</span>
                                </a>
                            }
                            else if (User.IsInRole("PostManager"))
                            {
                                <a class="public-login-button"
                                   asp-area="Admin"
                                   asp-controller="Posts"
                                   asp-action="Index">
                                    <i class="bi bi-file-earmark-text"
                                       aria-hidden="true"></i>
                                    <span>Posts</span>
                                </a>
                            }
                            else
                            {
                                <a class="public-login-button"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-person-circle"
                                       aria-hidden="true"></i>
                                    <span>Account</span>
                                </a>
                            }
                        }
                        else
                        {
                            <a class="public-login-button"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"
                                   aria-hidden="true"></i>
                                <span>Admin Login</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->
    <main role="main"
          class="public-main">
        @RenderBody()
    </main>
    <!-- =====================================================
         PUBLIC FOOTER
         ===================================================== -->
    <footer class="public-footer">
        <div class="public-container">
            <!-- =================================================
                 FOOTER MAIN GRID
                 ================================================= -->
            <div class="footer-grid">
                <!-- =================================================
                     FOUNDATION
                     ================================================= -->
                <div class="footer-column footer-about">
                    <div class="footer-brand">
                        <span class="footer-brand-mark">
                            @if (!string.IsNullOrWhiteSpace(
                                foundationSettings.LogoPath))
                            {
                                <img src="@foundationSettings.LogoPath"
                                     alt="@foundationSettings.FoundationName" />
                            }
                            else
                            {
                                <img src="~/images/foundation-logo.png"
                                     alt="@foundationSettings.FoundationName" />
                            }
                        </span>
                        <span class="footer-brand-name">
                            @foundationSettings.FoundationName
                        </span>
                    </div>
                    <p class="footer-about-text">
                        @foundationSettings.FoundationName
                        is committed to working together
                        to create a better future and make
                        a meaningful difference in our community.
                    </p>
                    <!-- SOCIAL LINKS -->
                    <div class="footer-social-links">
                        <a href="https://www.facebook.com/profile.php?id=61580846158459"
                           class="footer-social-link footer-facebook-link"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Visit us on Facebook">
                            <i class="bi bi-facebook"
                               aria-hidden="true"></i>
                            <span>Facebook</span>
                        </a>
                    </div>
                </div>
                <!-- =================================================
                     QUICK LINKS
                     ================================================= -->
                <div class="footer-column">
                    <h3>
                        <i class="bi bi-link-45deg"
                           aria-hidden="true"></i>
                        <span>Quick Links</span>
                    </h3>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        <i class="bi bi-house-door"
                           aria-hidden="true"></i>
                        <span>Home</span>
                    </a>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="About">
                        <i class="bi bi-info-circle"
                           aria-hidden="true"></i>
                        <span>About Us</span>
                    </a>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Causes">
                        <i class="bi bi-heart"
                           aria-hidden="true"></i>
                        <span>Our Work</span>
                    </a>
                    <a asp-area=""
                       asp-controller="Posts"
                       asp-action="Index">
                        <i class="bi bi-newspaper"
                           aria-hidden="true"></i>
                        <span>Updates</span>
                    </a>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Contact">
                        <i class="bi bi-envelope"
                           aria-hidden="true"></i>
                        <span>Contact</span>
                    </a>
                </div>
                <!-- =================================================
                     DONATIONS
                     ================================================= -->
                <div class="footer-column">
                    <h3>
                        <i class="bi bi-heart-fill"
                           aria-hidden="true"></i>
                        <span>Donations</span>
                    </h3>
                    <a asp-area=""
                       asp-controller="Donation"
                       asp-action="Index">
                        <i class="bi bi-heart-fill"
                           aria-hidden="true"></i>
                        <span>Donate Now</span>
                    </a>
                    <a asp-area=""
                       asp-controller="DonationStatus"
                       asp-action="Index">
                        <i class="bi bi-search-heart"
                           aria-hidden="true"></i>
                        <span>Check Donation Status</span>
                    </a>
                    <!-- SUPPORT -->
                    <div class="footer-help-buttons">
                        <a asp-area=""
                           asp-controller="Support"
                           asp-action="Index"
                           class="footer-help-button footer-support-link">
                            <i class="bi bi-hand-thumbs-up-fill"
                               aria-hidden="true"></i>
                            <span>Request Support</span>
                        </a>
                        <!-- GRIEVANCE -->
                        <a asp-area=""
                           asp-controller="Grievance"
                           asp-action="Index"
                           class="footer-help-button footer-grievance-link">
                            <i class="bi bi-chat-left-text-fill"
                               aria-hidden="true"></i>
                            <span>Submit Grievance</span>
                        </a>
                    </div>
                </div>
                <!-- =================================================
                     ADMINISTRATION
                     ================================================= -->
                <div class="footer-column">
                    <h3>
                        <i class="bi bi-building"
                           aria-hidden="true"></i>
                        <span>Administration</span>
                    </h3>
                    <!-- LEADERSHIP -->
                    <a asp-area=""
                       asp-controller="Foundation"
                       asp-action="Leadership">
                        <i class="bi bi-people-fill"
                           aria-hidden="true"></i>
                        <span>Leadership</span>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Administrator") ||
                            User.IsInRole("DonationVerifier"))
                        {
                            <a asp-area="Admin"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                <i class="bi bi-speedometer2"
                                   aria-hidden="true"></i>
                                <span>Dashboard</span>
                            </a>
                        }
                        else if (User.IsInRole("PostManager"))
                        {
                            <a asp-area="Admin"
                               asp-controller="Posts"
                               asp-action="Index">
                                <i class="bi bi-file-earmark-text"
                                   aria-hidden="true"></i>
                                <span>Posts</span>
                            </a>
                        }
                        else
                        {
                            <a asp-area=""
                               asp-controller="Account"
                               asp-action="Login">
                                <i class="bi bi-person-circle"
                                   aria-hidden="true"></i>
                                <span>Account</span>
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-area=""
                           asp-controller="Account"
                           asp-action="Login">
                            <i class="bi bi-shield-lock"
                               aria-hidden="true"></i>
                            <span>Admin Login</span>
                        </a>
                    }
                </div>
            </div>
            <!-- =================================================
                 LOCATION
                 ================================================= -->
            @if (!string.IsNullOrWhiteSpace(
                            foundationSettings.Address))
            {
                <div class="footer-location">
                    <div class="footer-location-header">
                        <div>
                            <span class="footer-location-eyebrow">
                                <i class="bi bi-geo-alt-fill"
                                   aria-hidden="true"></i>
                                Visit Us
                            </span>
                            <h3>
                                Our Location
                            </h3>
                            <p>
                                @foundationSettings.Address
                            </p>
                        </div>
                        <a class="footer-map-link"
                           href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(foundationSettings.Address)"
                           target="_blank"
                           rel="noopener noreferrer">
                            <i class="bi bi-map"
                               aria-hidden="true"></i>
                            <span>Open in Google Maps</span>
                        </a>
                    </div>
                    <div class="footer-map-frame">
                        <iframe src="https://www.google.com/maps?q=@Uri.EscapeDataString(foundationSettings.Address)&output=embed"
                                title="Foundation location map"
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                allowfullscreen>
                        </iframe>
                    </div>
                </div>
            }
            <!-- =================================================
                 FOOTER BOTTOM
                 ================================================= -->
            <div class="footer-bottom">
                <!-- COPYRIGHT -->
                <div class="footer-copyright">
                    <i class="bi bi-c-circle"
                       aria-hidden="true"></i>
                    <span>
                        @DateTime.Now.Year
                        @foundationSettings.FoundationName.
                        All rights reserved.
                    </span>
                </div>
                <!-- LEGAL + SOCIAL -->
                <div class="footer-legal">
                    <!-- PRIVACY -->
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">
                        <i class="bi bi-shield-check"
                           aria-hidden="true"></i>
                        <span>Privacy Policy</span>
                    </a>
                    <!-- FACEBOOK -->
                    <a href="https://www.facebook.com/profile.php?id=61580846158459"
                       class="footer-facebook-link"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Visit us on Facebook">
                        <i class="bi bi-facebook"
                           aria-hidden="true"></i>
                        <span>Facebook</span>
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <!-- =====================================================
         FOOTER / LAYOUT STYLES
         ===================================================== -->
    <style>
            /* =====================================================
                                   FOOTER COLUMN HEADINGS
                                   ===================================================== */
            .footer-column h3 {
                display: flex;
                align-items: center;
                gap: 9px;
            }

                .footer-column h3 i {
                    color: #fb923c;
                    font-size: 14px;
                    line-height: 1;
                }
            /* =====================================================
                                   FOOTER LINKS
                                   ===================================================== */
            .footer-column > a {
                display: flex;
                align-items: center;
                gap: 9px;
            }

                .footer-column > a i {
                    width: 17px;
                    color: #fb923c;
                    font-size: 13px;
                    text-align: center;
                    flex: 0 0 17px;
                }

                .footer-column > a span {
                    min-width: 0;
                }
            /* =====================================================
                                   FOOTER ABOUT
                                   ===================================================== */
            .footer-about-text {
                max-width: 360px;
            }
            /* =====================================================
                                   SOCIAL LINKS
                                   ===================================================== */
            .footer-social-links {
                display: flex;
                align-items: center;
                gap: 9px;
                margin-top: 20px;
            }

            .footer-social-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 36px;
                padding: 8px 13px;
                border: 1px solid rgba(255, 255, 255, .14);
                border-radius: 8px;
                background: rgba(255, 255, 255, .055);
                color: inherit;
                font-size: 12px;
                font-weight: 700;
                text-decoration: none;
                transition: background-color .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;
            }

                .footer-social-link i {
                    font-size: 14px;
                    line-height: 1;
                }

                .footer-social-link:hover {
                    color: #ffffff;
                    background: #1877f2;
                    border-color: #1877f2;
                    text-decoration: none;
                    transform: translateY(-2px);
                }
            /* =====================================================
                                   SUPPORT / GRIEVANCE
                                   ===================================================== */
            .footer-help-buttons {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
                margin-top: 12px;
            }

            .footer-help-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 36px;
                padding: 8px 12px;
                border: 1px solid rgba(255, 255, 255, .14);
                border-radius: 8px;
                color: inherit;
                font-size: 12px;
                line-height: 1.2;
                font-weight: 700;
                text-decoration: none;
                transition: background-color .18s ease, border-color .18s ease, color .18s ease, transform .18s ease, box-shadow .18s ease;
            }

                .footer-help-button i {
                    font-size: 13px;
                    line-height: 1;
                }

                .footer-help-button:hover {
                    color: #ffffff;
                    text-decoration: none;
                    transform: translateY(-1px);
                }

            .footer-support-link {
                background: rgba(234, 88, 12, .10);
                border-color: rgba(251, 146, 60, .30);
            }

                .footer-support-link:hover {
                    background: #ea580c;
                    border-color: #ea580c;
                    box-shadow: 0 5px 14px rgba(234, 88, 12, .20);
                }

            .footer-grievance-link {
                background: rgba(245, 158, 11, .08);
                border-color: rgba(251, 191, 36, .25);
            }

                .footer-grievance-link:hover {
                    background: #d97706;
                    border-color: #d97706;
                    box-shadow: 0 5px 14px rgba(217, 119, 6, .18);
                }
            /* =====================================================
                                   LOCATION
                                   ===================================================== */
            .footer-location-eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 7px;
            }

                .footer-location-eyebrow i {
                    color: #fb923c;
                }

            .footer-map-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

                .footer-map-link i {
                    font-size: 14px;
                }
            /* =====================================================
                                   FOOTER BOTTOM
                                   ===================================================== */
            .footer-bottom {
                display: flex;
                align-items: center;
                justify-content: space-between;
