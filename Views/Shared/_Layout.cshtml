    </style>
    <!-- =====================================================
         GOOGLE TRANSLATE ENGINE
         ===================================================== -->
    <div id="google_translate_element"
         aria-hidden="true">
    </div>
    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true">
    </script>
    <!-- =====================================================
         TRANSLATION
         ===================================================== -->
    <script>
            window.foundationTranslationReady = false;
            function googleTranslateElementInit() {
                new google.translate.TranslateElement(
                    {
                        pageLanguage: 'en',
                        includedLanguages: 'en,bn,hi',
                        autoDisplay: false
                    },
                    'google_translate_element'
                );
                window.foundationTranslationReady = true;
            }
            (function() {
                const languageButton =
                    document.getElementById(
                        'publicLanguageButton'
                    );
                const languageMenu =
                    document.getElementById(
                        'publicLanguageMenu'
                    );
                const languageLabel =
                    document.getElementById(
                        'publicLanguageLabel'
                    );
                if (
                    !languageButton ||
                    !languageMenu ||
                    !languageLabel
                ) {
                    return;
                }
                const labels = {
                    en: 'English',
                    bn: 'বাংলা',
                    hi: 'हिन्दी'
                };
                function getCookie(name) {
                    const value =
                        document.cookie
                            .split('; ')
                            .find(
                                row =>
                                    row.startsWith(
                                        name + '='
                                    )
                            );
                    return value
                        ? decodeURIComponent(
                            value.split('=')[1]
                        )
                        : '';
                }
                function getCurrentLanguage() {
                    const cookie =
                        getCookie('googtrans');
                    const match =
                        cookie.match(
                            /\/en\/([a-z-]+)/i
                        );
                    return match
                        ? match[1].toLowerCase()
                        : 'en';
                }
                function setCookie(
                    name,
                    value
                ) {
                    document.cookie =
                        name +
                        '=' +
                        encodeURIComponent(value) +
                        '; path=/; max-age=31536000; SameSite=Lax';
                }
                function applyLanguage(
                    language
                ) {
                    language =
                        labels[language]
                            ? language
                            : 'en';
                    setCookie(
                        'googtrans',
                        '/en/' + language
                    );
                    setCookie(
                        'googtrans',
                        '/en/' + language,
                        location.hostname
                    );
                    languageLabel.textContent =
                        labels[language];
                    document
                        .querySelectorAll(
                            '.public-language-option'
                        )
                        .forEach(
                            function(option) {
                                option.classList.toggle(
                                    'active',
                                    option.dataset.language === language
                                );
                            }
                        );
                    const select =
                        document.querySelector(
                            '.goog-te-combo'
                        );
                    if (select) {
                        select.value =
                            language;
                        select.dispatchEvent(
                            new Event('change')
                        );
                    }
                    else {
                        window.location.reload();
                    }
                    closeLanguageMenu();
                }
                function openLanguageMenu() {
                    languageMenu.classList.add(
                        'show'
                    );
                    languageMenu.setAttribute(
                        'aria-hidden',
                        'false'
                    );
                    languageButton.setAttribute(
                        'aria-expanded',
                        'true'
                    );
                }
                function closeLanguageMenu() {
                    languageMenu.classList.remove(
                        'show'
                    );
                    languageMenu.setAttribute(
                        'aria-hidden',
                        'true'
                    );
                    languageButton.setAttribute(
                        'aria-expanded',
                        'false'
                    );
                }
                languageButton.addEventListener(
                    'click',
                    function(event) {
                        event.stopPropagation();
                        if (
                            languageMenu.classList.contains(
                                'show'
                            )
                        ) {
                            closeLanguageMenu();
                        }
                        else {
                            openLanguageMenu();
                        }
                    }
                );
                languageMenu
                    .querySelectorAll(
                        '.public-language-option'
                    )
                    .forEach(
                        function(option) {
                            option.addEventListener(
                                'click',
                                function() {
                                    applyLanguage(
                                        option.dataset.language
                                    );
                                }
                            );
                        }
                    );
                document.addEventListener(
                    'click',
                    function(event) {
                        if (
                            !languageMenu.contains(
                                event.target
                            ) &&
                            !languageButton.contains(
                                event.target
                            )
                        ) {
                            closeLanguageMenu();
                        }
                    }
                );
                document.addEventListener(
                    'keydown',
                    function(event) {
                        if (
                            event.key === 'Escape'
                        ) {
                            closeLanguageMenu();
                        }
                    }
                );
                const current =
                    getCurrentLanguage();
                languageLabel.textContent =
                    labels[current] ||
                    labels.en;
                document
                    .querySelectorAll(
                        '.public-language-option'
                    )
                    .forEach(
                        function(option) {
                            option.classList.toggle(
                                'active',
                                option.dataset.language === current
                            );
                        }
                    );
            })();
    </script>
    <!-- =====================================================
         GOOGLE TRANSLATE SCRIPT
         ===================================================== -->
    <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit">
    </script>
    <!-- =====================================================
         MOBILE NAVIGATION
         ===================================================== -->
    <script>
            document.addEventListener(
                "DOMContentLoaded",
                function() {
                    const toggle =
                        document.querySelector(
                            ".public-menu-toggle"
                        );
                    const navigation =
                        document.querySelector(
                            ".public-navigation"
                        );
                    if (
                        !toggle ||
                        !navigation
                    ) {
                        return;
                    }
                    toggle.addEventListener(
                        "click",
                        function() {
                            const isOpen =
                                navigation.classList.toggle(
                                    "is-open"
                                );
                            toggle.classList.toggle(
                                "is-open",
                                isOpen
                            );
                            toggle.setAttribute(
                                "aria-expanded",
                                isOpen.toString()
                            );
                        }
                    );
                    /*
                     * Close mobile menu when
                     * navigation link is clicked.
                     */
                    navigation
                        .querySelectorAll("a")
                        .forEach(
                            function(link) {
                                link.addEventListener(
                                    "click",
                                    function() {
                                        navigation.classList.remove(
                                            "is-open"
                                        );
                                        toggle.classList.remove(
                                            "is-open"
                                        );
                                        toggle.setAttribute(
                                            "aria-expanded",
                                            "false"
                                        );
                                    }
                                );
                            }
                        );
                }
            );
    </script>
    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>