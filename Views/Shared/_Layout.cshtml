@using FoundationDonationSystem.Models
@inject FoundationDonationSystem.Services.IFoundationSettingsService FoundationSettingsService
@{
    var foundationSettings = await FoundationSettingsService.GetAsync();
}
@{
    var controllerName =
        ViewContext.RouteData.Values["controller"]?.ToString()
        ?? string.Empty;
    var actionName =
        ViewContext.RouteData.Values["action"]?.ToString()
        ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>
        @ViewData["Title"] - @foundationSettings.FoundationName
    </title>
    <script type="importmap"></script>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-posts.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/FoundationDonationSystem.styles.css"
          asp-append-version="true" />
    @await RenderSectionAsync(
        "Styles",
        required: false)
</head>
<body>
    <!-- =====================================================
         PUBLIC HEADER
         ===================================================== -->
    <header class="public-header">
        <nav class="public-navbar">
            <div class="public-container">
                <!-- =================================================
                     BRAND
                     ================================================= -->
                <a class="foundation-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="foundation-brand-mark">
                        @if (!string.IsNullOrWhiteSpace(
                            foundationSettings.LogoPath))
                        {
                            <img src="@foundationSettings.LogoPath"
                                 alt="@foundationSettings.FoundationName" />
                        }
                        else
                        {
                            <img src="~/images/foundation-logo.png"
                                 alt="@foundationSettings.FoundationName" />
                        }
                    </span>
                    <span class="foundation-brand-content">
                        <span class="foundation-brand-name">
                            @foundationSettings.FoundationName
                        </span>
                        <span class="foundation-brand-subtitle">
                            @foundationSettings.Tagline
                        </span>
                    </span>
                </a>
                <!-- =================================================
                     MOBILE MENU BUTTON
                     ================================================= -->
                <button class="public-menu-toggle"
                        type="button"
                        aria-label="Toggle navigation"
                        aria-expanded="false"
                        aria-controls="publicNavigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <!-- =================================================
                     NAVIGATION
                     ================================================= -->
                <div class="public-navigation"
                     id="publicNavigation">
                    <div class="public-nav-links">
                        <!-- HOME -->
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           class="public-nav-link @(controllerName.Equals("Home", StringComparison.OrdinalIgnoreCase) && actionName.Equals("Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            Home
                        </a>
                        <!-- OUR WORK -->
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Causes"
                           class="public-nav-link @(controllerName.Equals("Home", StringComparison.OrdinalIgnoreCase) && actionName.Equals("Causes", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            Our Work
                        </a>
                        <!-- UPDATES -->
                        <a asp-area=""
                           asp-controller="Posts"
                           asp-action="Index"
                           class="public-nav-link @(controllerName.Equals("Posts", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="bi bi-newspaper"></i>
                            <span>Updates</span>
                        </a>
                        <!-- DONATION STATUS -->
                        <a asp-area=""
                           asp-controller="DonationStatus"
                           asp-action="Index"
                           class="public-nav-link @(controllerName.Equals("DonationStatus", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            Donation Status
                        </a>
                    </div>
                    <!-- DONATE -->
                        <a class="public-donate-button"
                           asp-area=""
                           asp-controller="Donation"
                           asp-action="Index">
                            <span class="public-donate-icon">
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M12 21s-7-4.35-9.33-8.2C.54 9.82 2.15 6 5.67 6c1.88 0 3.07 1.05 4.33 2.4C11.26 7.05 12.45 6 14.33 6 17.85 6 19.46 9.82 17.33 12.8 15 16.65 12 21 12 21Z" />
                                </svg>
                            </span>
                            Donate Now
                        </a>
                    <!-- =================================================
                         HEADER ACTIONS
                         ================================================= -->
                    <div class="public-nav-actions">
                        <!-- LANGUAGE -->
                        <div class="public-language-selector">
                            <button type="button"
                                    class="public-language-button"
                                    id="publicLanguageButton"
                                    aria-haspopup="true"
                                    aria-expanded="false">
                                <i class="bi bi-translate" aria-hidden="true"></i>
                                <span id="publicLanguageLabel">English</span>
                                <i class="bi bi-chevron-down public-language-chevron" aria-hidden="true"></i>
                            </button>
                            <div class="public-language-menu"
                                 id="publicLanguageMenu"
                                 role="menu"
                                 aria-hidden="true">
                                <button type="button" class="public-language-option active" data-language="en" role="menuitem">
                                    <span>English</span>
                                </button>
                                <button type="button" class="public-language-option" data-language="bn" role="menuitem">
                                    <span>বাংলা</span>
                                </button>
                                <button type="button" class="public-language-option" data-language="hi" role="menuitem">
                                    <span>हिन्दी</span>
                                </button>
                            </div>
                        </div>
                        <!-- =================================================
                             ADMIN / DASHBOARD
                             ================================================= -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Administrator") ||
                                User.IsInRole("DonationVerifier"))
                            {
                                <a class="public-login-button"
                                   asp-area="Admin"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="bi bi-speedometer2"></i>
                                    <span>Dashboard</span>
                                </a>
                            }
                            else if (User.IsInRole("PostManager"))
                            {
                                <a class="public-login-button"
                                   asp-area="Admin"
                                   asp-controller="Posts"
                                   asp-action="Index">
                                    <i class="bi bi-file-earmark-text"></i>
                                    <span>Posts</span>
                                </a>
                            }
                            else
                            {
                                <a class="public-login-button"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-person-circle"></i>
                                    <span>Account</span>
                                </a>
                            }
                        }
                        else
                        {
                            <a class="public-login-button"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Admin Login</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->
    <main role="main"
          class="public-main">
        @RenderBody()
    </main>
    <!-- =====================================================
         PUBLIC FOOTER
         ===================================================== -->
    <footer class="public-footer">
        <div class="public-container">
            <div class="footer-grid">
                <!-- =================================================
                     FOUNDATION
                     ================================================= -->
                <div class="footer-column footer-about">
                    <div class="footer-brand">
                        <span class="footer-brand-mark">
                            @if (!string.IsNullOrWhiteSpace(
                                foundationSettings.LogoPath))
                            {
                                <img src="@foundationSettings.LogoPath"
                                     alt="@foundationSettings.FoundationName" />
                            }
                            else
                            {
                                <img src="~/images/foundation-logo.png"
                                     alt="@foundationSettings.FoundationName" />
                            }
                        </span>
                        <span class="footer-brand-name">
                            @foundationSettings.FoundationName
                        </span>
                    </div>
                    <p>
                        @foundationSettings.FoundationName
                        Working together to create a better
                        future and make a meaningful difference
                        in our community.
                    </p>
                </div>
                <!-- =================================================
                     QUICK LINKS
                     ================================================= -->
                <div class="footer-column">
                    <h3>
                        Quick Links
                    </h3>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="About">
                        About Us
                    </a>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Causes">
                        Our Work
                    </a>
                    <a asp-area=""
                       asp-controller="Posts"
                       asp-action="Index">
                        Updates
                    </a>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Contact">
                        Contact
                    </a>
                </div>
                <!-- =================================================
                     DONATIONS
                     ================================================= -->
                <div class="footer-column">
                    <h3>
                        Donations
                    </h3>
                    <a asp-area=""
                       asp-controller="Donation"
                       asp-action="Index">
                        Donate Now
                    </a>
                    <a asp-area=""
                       asp-controller="DonationStatus"
                       asp-action="Index">
                        Check Donation Status
                    </a>
                    <!-- SUPPORT & GRIEVANCE -->
                    <div class="footer-help-buttons">
                        <a asp-area=""
                           asp-controller="Support"
                           asp-action="Index"
                           class="footer-help-button footer-support-link">
                            <i class="bi bi-hand-thumbs-up-fill"
                               aria-hidden="true"></i>
                            <span>Request Support</span>
                        </a>
                        <a asp-area=""
                           asp-controller="Grievance"
                           asp-action="Index"
                           class="footer-help-button footer-grievance-link">
                            <i class="bi bi-chat-left-text-fill"
                               aria-hidden="true"></i>
                            <span>Submit Grievance</span>
                        </a>
                    </div>
                </div>
                <!-- =================================================
                     ADMINISTRATION
                     ================================================= -->
                <div class="footer-column">
                    <h3>
                        Administration
                    </h3>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <a asp-area="Admin"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        }
                        else if (User.IsInRole("PostManager"))
                        {
                            <a asp-area="Admin"
                               asp-controller="Posts"
                               asp-action="Index">
                                Posts
                            </a>
                        }
                        else
                        {
                            <a asp-area=""
                               asp-controller="Account"
                               asp-action="Login">
                                Account
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-area=""
                           asp-controller="Account"
                           asp-action="Login">
                            Admin Login
                        </a>
                    }
                </div>
            </div>
            <!-- =================================================
                 LOCATION
                 ================================================= -->
            @if (!string.IsNullOrWhiteSpace(foundationSettings.Address))
            {
                <div class="footer-location">
                    <div class="footer-location-header">
                        <div>
                            <span class="footer-location-eyebrow">
                                Visit Us
                            </span>
                            <h3>Our Location</h3>
                            <p>
                                @foundationSettings.Address
                            </p>
                        </div>
                        <a class="footer-map-link"
                           href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(foundationSettings.Address)"
                           target="_blank"
                           rel="noopener noreferrer">
                            <i class="bi bi-geo-alt-fill"
                               aria-hidden="true"></i>
                            Open in Google Maps
                        </a>
                    </div>
                    <div class="footer-map-frame">
                        <iframe
                            src="https://www.google.com/maps?q=@Uri.EscapeDataString(foundationSettings.Address)&output=embed"
                            title="Foundation location map"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            allowfullscreen>
                        </iframe>
                    </div>
                </div>
            }
            <!-- =================================================
                 FOOTER BOTTOM
                 ================================================= -->
            <div class="footer-bottom">
                <div class="footer-copyright">
                    &copy; @DateTime.Now.Year
                    @foundationSettings.FoundationName.
                    All rights reserved.
                </div>
                <div class="footer-legal">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">
                        Privacy Policy
                    </a>
                    <a href="https://www.facebook.com/profile.php?id=61580846158459"
                       class="footer-facebook-link"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Visit us on Facebook">
                        <i class="bi bi-facebook"
                           aria-hidden="true"></i>
                        <span>Facebook</span>
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <style>
        /* =========================================================
           FACEBOOK FOOTER LINK
           ========================================================= */
        .footer-legal {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
            flex-wrap: wrap;
        }
        .footer-facebook-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            color: inherit;
            text-decoration: none;
            transition: color .18s ease, transform .18s ease;
        }
        .footer-facebook-link i {
            font-size: 13px;
            line-height: 1;
        }
        .footer-facebook-link:hover {
            color: #1877f2;
            text-decoration: none;
            transform: translateY(-1px);
        }
        /* =========================================================
           SUPPORT & GRIEVANCE FOOTER BUTTONS
           ========================================================= */
        .footer-help-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }
        .footer-help-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 36px;
            padding: 7px 11px;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 7px;
            background: rgba(255, 255, 255, .07);
            color: inherit;
            font-size: 12px;
            line-height: 1.2;
            font-weight: 700;
            text-decoration: none;
            transition: background-color .18s ease,
                        border-color .18s ease,
                        color .18s ease,
                        transform .18s ease,
                        box-shadow .18s ease;
        }
        .footer-help-button i {
            font-size: 13px;
            line-height: 1;
        }
        .footer-help-button:hover {
            background: #ea580c;
            border-color: #ea580c;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(234, 88, 12, .20);
        }
        .footer-support-link {
            background: rgba(234, 88, 12, .10);
            border-color: rgba(251, 146, 60, .35);
        }
        .footer-grievance-link {
            background: rgba(245, 158, 11, .08);
            border-color: rgba(251, 191, 36, .30);
        }
        .footer-grievance-link:hover {
            background: #d97706;
            border-color: #d97706;
        }
        @@media (max-width: 560px) {
            .footer-legal {
                justify-content: center;
                gap: 10px;
            }
            .footer-help-buttons {
                flex-direction: column;
                align-items: stretch;
            }
            .footer-help-button {
                width: 100%;
            }
        }
    </style>
    <!-- Google Translate engine (hidden; controlled by our language selector) -->
    <div id="google_translate_element" aria-hidden="true"></div>
    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>
    <!-- =====================================================
         TRANSLATION
         ===================================================== -->
    <script>
        window.foundationTranslationReady = false;
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,bn,hi',
                autoDisplay: false
            }, 'google_translate_element');
            window.foundationTranslationReady = true;
        }
        (function () {
            const languageButton = document.getElementById('publicLanguageButton');
            const languageMenu = document.getElementById('publicLanguageMenu');
            const languageLabel = document.getElementById('publicLanguageLabel');
            if (!languageButton || !languageMenu || !languageLabel) {
                return;
            }
            const labels = {
                en: 'English',
                bn: 'বাংলা',
                hi: 'हिन्दी'
            };
            function getCookie(name) {
                const value = document.cookie
                    .split('; ')
                    .find(row => row.startsWith(name + '='));
                return value ? decodeURIComponent(value.split('=')[1]) : '';
            }
            function getCurrentLanguage() {
                const cookie = getCookie('googtrans');
                const match = cookie.match(/\/en\/([a-z-]+)/i);
                return match ? match[1].toLowerCase() : 'en';
            }
            function setCookie(name, value) {
                document.cookie = name + '=' + encodeURIComponent(value) + '; path=/; max-age=31536000; SameSite=Lax';
            }
            function applyLanguage(language) {
                language = labels[language] ? language : 'en';
                setCookie('googtrans', '/en/' + language);
                setCookie('googtrans', '/en/' + language, location.hostname);
                languageLabel.textContent = labels[language];
                document.querySelectorAll('.public-language-option').forEach(function (option) {
                    option.classList.toggle('active', option.dataset.language === language);
                });
                const select = document.querySelector('.goog-te-combo');
                if (select) {
                    select.value = language;
                    select.dispatchEvent(new Event('change'));
                } else {
                    // The Google Translate widget can load slightly after our UI.
                    // Reloading with the cookie guarantees translation on the first selection.
                    window.location.reload();
                }
                closeLanguageMenu();
            }
            function openLanguageMenu() {
                languageMenu.classList.add('show');
                languageMenu.setAttribute('aria-hidden', 'false');
                languageButton.setAttribute('aria-expanded', 'true');
            }
            function closeLanguageMenu() {
                languageMenu.classList.remove('show');
                languageMenu.setAttribute('aria-hidden', 'true');
                languageButton.setAttribute('aria-expanded', 'false');
            }
            languageButton.addEventListener('click', function (event) {
                event.stopPropagation();
                if (languageMenu.classList.contains('show')) {
                    closeLanguageMenu();
                } else {
                    openLanguageMenu();
                }
            });
            languageMenu.querySelectorAll('.public-language-option').forEach(function (option) {
                option.addEventListener('click', function () {
                    applyLanguage(option.dataset.language);
                });
            });
            document.addEventListener('click', function (event) {
                if (!languageMenu.contains(event.target) && !languageButton.contains(event.target)) {
                    closeLanguageMenu();
                }
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeLanguageMenu();
                }
            });
            const current = getCurrentLanguage();
            languageLabel.textContent = labels[current] || labels.en;
            document.querySelectorAll('.public-language-option').forEach(function (option) {
                option.classList.toggle('active', option.dataset.language === current);
            });
        })();
    </script>
    <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    <!-- =====================================================
         MOBILE NAVIGATION
         ===================================================== -->
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const toggle =
                    document.querySelector(
                        ".public-menu-toggle"
                    );
                const navigation =
                    document.querySelector(
                        ".public-navigation"
                    );
                if (!toggle || !navigation) {
                    return;
                }
                toggle.addEventListener(
                    "click",
                    function () {
                        const isOpen =
                            navigation.classList.toggle(
                                "is-open"
                            );
                        toggle.classList.toggle(
                            "is-open",
                            isOpen
                        );
                        toggle.setAttribute(
                            "aria-expanded",
                            isOpen.toString()
                        );
                    }
                );
                /*
                 * Close mobile menu when a navigation
                 * link is clicked.
                 */
                navigation
                    .querySelectorAll("a")
                    .forEach(
                        function (link) {
                            link.addEventListener(
                                "click",
                                function () {
                                    navigation.classList.remove(
                                        "is-open"
                                    );
                                    toggle.classList.remove(
                                        "is-open"
                                    );
                                    toggle.setAttribute(
                                        "aria-expanded",
                                        "false"
                                    );
                                }
                            );
                        }
                    );
            }
        );
    </script>
    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>