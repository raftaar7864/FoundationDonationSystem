@{
    ViewData["Title"] = "Access Denied";
}
<div class="account-page access-denied-page">
    <div class="access-denied-card">
        <!-- =====================================================
             ICON
             ===================================================== -->
        <div class="access-denied-icon">
            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <rect x="4"
                      y="10"
                      width="16"
                      height="11"
                      rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                <path d="M12 14v3" />
                <circle cx="12"
                        cy="18"
                        r=".5" />
            </svg>
        </div>
        <!-- =====================================================
             CONTENT
             ===================================================== -->
        <div class="access-denied-content">
            <span class="access-denied-eyebrow">
                Authorization Required
            </span>
            <h1>
                Access Denied
            </h1>
            <p>
                You do not have permission to access this page.
                Please contact an administrator if you believe
                you should have access.
            </p>
        </div>
        <!-- =====================================================
             ACTIONS
             ===================================================== -->
        <div class="access-denied-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="access-denied-button primary">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M3 10.5 12 3l9 7.5" />
                        <path d="M5 9.5V21h14V9.5" />
                        <path d="M9 21v-6h6v6" />
                    </svg>
                    <span>
                        Go to Dashboard
                    </span>
                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="access-denied-button primary">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5" />
                        <path d="M14 8l5 4-5 4" />
                        <path d="M19 12H9" />
                    </svg>
                    <span>
                        Back to Sign In
                    </span>
                </a>
            }
            <button type="button"
                    class="access-denied-button secondary"
                    onclick="history.back()">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                </svg>
                <span>
                    Go Back
                </span>
            </button>
        </div>
        <!-- =====================================================
             FOOTER
             ===================================================== -->
        <div class="access-denied-footer">
            <span>
                Foundation Administration
            </span>
        </div>
    </div>
</div>