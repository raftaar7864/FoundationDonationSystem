@using FoundationDonationSystem.Models
@using FoundationDonationSystem.ViewModels
@inject FoundationDonationSystem.Services.IFoundationSettingsService FoundationSettingsService
@{
    ViewData["Title"] = "Home";
    var foundation = await FoundationSettingsService.GetAsync();
    var foundationName = string.IsNullOrWhiteSpace(foundation.FoundationName)
        ? "Foundation"
        : foundation.FoundationName;
    var tagline = string.IsNullOrWhiteSpace(foundation.Tagline)
        ? "Serving with compassion • Supporting with purpose"
        : foundation.Tagline;
    var logoPath = string.IsNullOrWhiteSpace(foundation.LogoPath)
        ? Url.Content("~/images/foundation-logo.png")
        : foundation.LogoPath;
    var latestPosts =
        ViewBag.LatestPosts as IEnumerable<PublicPostListViewModel>
        ?? Enumerable.Empty<PublicPostListViewModel>();
    const string facebookUrl =
        "https://www.facebook.com/profile.php?id=61580846158459";
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
    <style>
        /* =========================================================
                   UNIQUE HOME EXPERIENCE
                   ========================================================= */
        .foundation-home {
            --home-orange: #f97316;
            --home-orange-dark: #c2410c;
            --home-ink: #172033;
            --home-muted: #64748b;
            --home-line: #e8eaf0;
            --home-soft: #fff7ed;
            overflow: hidden;
        }
        .home-container {
            width: min(1180px, calc(100% - 40px));
            margin: 0 auto;
        }
        /* Hero */
        .home-hero {
            position: relative;
            min-height: clamp(600px, 78vh, 760px);
            display: flex;
            align-items: center;
            overflow: hidden;
            background: radial-gradient(circle at 84% 20%, rgba(249,115,22,.18), transparent 30%), radial-gradient(circle at 12% 85%, rgba(251,191,36,.12), transparent 28%), linear-gradient(135deg,#fffaf5 0%,#ffffff 48%,#fff7ed 100%);
        }
            .home-hero::before {
                content: "";
                position: absolute;
                width: 420px;
                height: 420px;
                right: -170px;
                top: -170px;
                border: 1px solid rgba(249,115,22,.14);
                border-radius: 50%;
            }
            .home-hero::after {
                content: "";
                position: absolute;
                width: 680px;
                height: 680px;
                right: -300px;
                top: -300px;
                border: 1px solid rgba(249,115,22,.08);
                border-radius: 50%;
            }
        .home-hero-container {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: minmax(0,1.08fr) minmax(360px,.92fr);
            gap: 70px;
            align-items: center;
            padding: 72px 0 84px;
        }
        .home-hero-content {
            max-width: 700px;
        }
        .home-eyebrow,
        .home-section-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--home-orange-dark);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .13em;
            text-transform: uppercase;
        }
        .home-eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--home-orange);
            box-shadow: 0 0 0 5px rgba(249,115,22,.10);
        }
        .home-hero-title {
            margin: 18px 0 12px;
            color: var(--home-ink);
            font-size: clamp(42px,6vw,76px);
            line-height: .98;
            letter-spacing: -.045em;
            font-weight: 800;
        }
            .home-hero-title span {
                display: block;
                color: var(--home-orange);
            }
        .home-hero-tagline {
            max-width: 620px;
            margin: 0 0 15px;
            color: #334155;
            font-size: clamp(20px,2.1vw,27px);
            line-height: 1.35;
            font-weight: 650;
        }
        .home-hero-description {
            max-width: 620px;
            margin: 0;
            color: var(--home-muted);
            font-size: 16px;
            line-height: 1.8;
        }
        .home-hero-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin-top: 28px;
        }
        .home-primary-button,
        .home-secondary-button,
        .home-outline-button,
        .home-contact-button {
            min-height: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 0 18px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        }
        .home-primary-button {
            color: #fff;
            background: linear-gradient(135deg,#f97316,#ea580c);
            box-shadow: 0 12px 25px rgba(234,88,12,.20);
        }
            .home-primary-button:hover,
            .home-contact-button:hover {
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 15px 28px rgba(234,88,12,.24);
            }
            .home-primary-button svg,
            .home-secondary-button svg,
            .home-outline-button svg,
            .home-contact-button svg,
            .home-text-link svg,
            .home-updates-view-all svg,
            .home-update-read-more svg {
                width: 16px;
                height: 16px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
                flex: 0 0 16px;
            }
        .home-secondary-button {
            color: var(--home-ink);
            background: #fff;
            border: 1px solid #e2e8f0;
        }
            .home-secondary-button:hover {
                color: var(--home-orange-dark);
                border-color: #fed7aa;
                transform: translateY(-2px);
            }
        .home-trust-note {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-top: 20px;
            color: #64748b;
            font-size: 11px;
            font-weight: 650;
        }
        .home-trust-icon {
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            color: #ea580c;
            background: #ffedd5;
        }
            .home-trust-icon svg {
                width: 16px;
                height: 16px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.7;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
        /* Hero visual */
        .home-hero-visual {
            position: relative;
            min-height: 410px;
            display: grid;
            place-items: center;
        }
        .home-hero-orbit {
            position: absolute;
            border: 1px solid rgba(249,115,22,.16);
            border-radius: 50%;
        }
        .home-orbit-one {
            width: 390px;
            height: 390px;
        }
        .home-orbit-two {
            width: 500px;
            height: 500px;
        }
        .home-hero-card {
            position: relative;
            width: min(390px,90%);
            padding: 30px;
            border: 1px solid rgba(255,255,255,.9);
            border-radius: 28px;
            background: rgba(255,255,255,.88);
            box-shadow: 0 28px 70px rgba(51,65,85,.14);
            backdrop-filter: blur(14px);
        }
        .home-hero-logo {
            width: 82px;
            height: 82px;
            display: grid;
            place-items: center;
            margin-bottom: 24px;
            border-radius: 22px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            overflow: hidden;
        }
            .home-hero-logo img {
                width: 70%;
                height: 70%;
                object-fit: contain;
            }
        .home-hero-card-label {
            display: block;
            margin-bottom: 8px;
            color: #f97316;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
        }
        .home-hero-card-content strong {
            display: block;
            color: var(--home-ink);
            font-size: 29px;
            line-height: 1.12;
            letter-spacing: -.025em;
        }
        .home-hero-card-content p {
            margin: 13px 0 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.65;
        }
        .home-hero-heart {
            position: absolute;
            right: -15px;
            bottom: -15px;
            width: 62px;
            height: 62px;
            display: grid;
            place-items: center;
            color: #fff;
            border: 7px solid #fff;
            border-radius: 50%;
            background: #f97316;
            box-shadow: 0 12px 28px rgba(234,88,12,.24);
        }
            .home-hero-heart svg {
                width: 25px;
                height: 25px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.7;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
        .home-scroll-indicator {
            position: absolute;
            left: 50%;
            bottom: 20px;
            z-index: 3;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 8px;
            color: #94a3b8;
            font-size: 10px;
            font-weight: 750;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .home-scroll-arrow {
            display: grid;
            place-items: center;
            width: 24px;
            height: 24px;
            border: 1px solid #e2e8f0;
            border-radius: 50%;
        }
            .home-scroll-arrow svg {
                width: 13px;
                height: 13px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.7;
            }
        /* Shared sections */
        .home-intro,
        .home-how-it-works,
        .home-updates,
        .home-community {
            padding: 92px 0;
        }
        .home-intro {
            background: #fff;
        }
        .home-section-heading {
            max-width: 680px;
        }
            .home-section-heading h2 {
                margin: 10px 0 10px;
                color: var(--home-ink);
                font-size: clamp(29px,4vw,45px);
                line-height: 1.08;
                letter-spacing: -.035em;
            }
            .home-section-heading p {
                margin: 0;
                color: var(--home-muted);
                font-size: 15px;
                line-height: 1.75;
            }
        .home-section-heading-center {
            margin: 0 auto;
            text-align: center;
        }
        .home-intro-grid {
            display: grid;
            grid-template-columns: minmax(0,1fr) minmax(360px,.86fr);
            gap: 70px;
            margin-top: 55px;
            align-items: start;
        }
        .home-intro-main {
            position: relative;
            padding: 5px 0 5px 62px;
        }
        .home-section-number {
            position: absolute;
            left: 0;
            top: 2px;
            color: #fed7aa;
            font-size: 27px;
            font-weight: 850;
        }
        .home-intro-main h3 {
            margin: 0 0 15px;
            color: var(--home-ink);
            font-size: 29px;
            line-height: 1.2;
        }
        .home-intro-main p {
            margin: 0 0 14px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.85;
        }
        .home-text-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-top: 7px;
            color: #ea580c;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
        }
        .home-values {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }
        .home-value-card {
            width: 100%;
            min-height: 68px;
            display: grid;
            grid-template-columns: 42px minmax(0,1fr) 22px;
            align-items: center;
            gap: 12px;
            padding: 10px 13px;
            border: 1px solid #edf0f4;
            border-radius: 13px;
            color: var(--home-ink);
            background: #fff;
            text-align: left;
            cursor: pointer;
            transition: all .2s ease;
        }
            .home-value-card:hover,
            .home-value-card.is-active {
                border-color: #fed7aa;
                background: #fffaf5;
                transform: translateX(3px);
            }
        .home-value-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            color: #ea580c;
            background: #fff7ed;
        }
            .home-value-icon svg {
                width: 20px;
                height: 20px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.7;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
        .home-value-card strong,
        .home-value-card small {
            display: block;
        }
        .home-value-card strong {
            font-size: 13px;
        }
        .home-value-card small {
            margin-top: 2px;
            color: #94a3b8;
            font-size: 10px;
        }
        .home-value-arrow {
            color: #cbd5e1;
            font-size: 18px;
        }
        .home-value-detail {
            margin-top: 8px;
            padding: 16px 18px;
            border-left: 3px solid #f97316;
            border-radius: 0 10px 10px 0;
            background: #fff7ed;
            transition: opacity .14s ease, transform .14s ease;
        }
            .home-value-detail.is-changing {
                opacity: .25;
                transform: translateY(3px);
            }
        .home-detail-label {
            display: block;
            color: #c2410c;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .home-value-detail p {
            margin: 6px 0 0;
            color: #64748b;
            font-size: 12px;
            line-height: 1.65;
        }
        /* Process */
        .home-how-it-works {
            background: #fafafa;
            border-top: 1px solid #f1f5f9;
            border-bottom: 1px solid #f1f5f9;
        }
        .home-process {
            display: grid;
            grid-template-columns: 1fr 70px 1fr 70px 1fr;
            align-items: center;
            margin-top: 55px;
        }
        .home-process-item {
            text-align: center;
        }
        .home-process-number {
            margin-bottom: 11px;
            color: #fb923c;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: .12em;
        }
        .home-process-icon {
            width: 62px;
            height: 62px;
            display: grid;
            place-items: center;
            margin: 0 auto 16px;
            color: #ea580c;
            border: 1px solid #fed7aa;
            border-radius: 50%;
            background: #fff;
        }
            .home-process-icon svg {
                width: 25px;
                height: 25px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.7;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
        .home-process-item h3 {
            margin: 0 0 8px;
            color: var(--home-ink);
            font-size: 16px;
        }
        .home-process-item p {
            max-width: 230px;
            margin: 0 auto;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.65;
        }
        .home-process-line {
            height: 1px;
            background: #e2e8f0;
        }
        /* Updates */
        .home-updates {
            background: #fff;
        }
        .home-updates-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 25px;
            margin-bottom: 38px;
        }
        .home-updates-view-all {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #ea580c;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
        }
        .home-updates-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 18px;
        }
        .home-update-card {
            overflow: hidden;
            border: 1px solid #edf0f4;
            border-radius: 15px;
            background: #fff;
            box-shadow: 0 7px 22px rgba(15,23,42,.035);
            transition: transform .2s ease, box-shadow .2s ease;
        }
            .home-update-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 17px 35px rgba(15,23,42,.08);
            }
        .home-update-image {
            position: relative;
            display: block;
            height: 190px;
            overflow: hidden;
            background: #f8fafc;
            text-decoration: none;
        }
            .home-update-image img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
                transition: transform .4s ease;
            }
        .home-update-card:hover .home-update-image img {
            transform: scale(1.04);
        }
        .home-update-date {
            position: absolute;
            left: 12px;
            bottom: 12px;
            padding: 6px 8px;
            border-radius: 7px;
            color: #fff;
            background: rgba(15,23,42,.78);
            backdrop-filter: blur(7px);
            font-size: 9px;
            font-weight: 800;
        }
        .home-update-image-placeholder {
            width: 100%;
            height: 100%;
            display: grid;
            place-items: center;
            color: #cbd5e1;
            background: linear-gradient(135deg,#fff7ed,#f8fafc);
        }
            .home-update-image-placeholder svg {
                width: 40px;
                height: 40px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.4;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
        .home-update-content {
            padding: 17px 18px 18px;
        }
        .home-update-meta {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #94a3b8;
            font-size: 9px;
            font-weight: 750;
        }
            .home-update-meta svg {
                width: 13px;
                height: 13px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.6;
            }
        .home-update-content h3 {
            margin: 9px 0 8px;
            font-size: 17px;
            line-height: 1.35;
        }
            .home-update-content h3 a {
                color: var(--home-ink);
                text-decoration: none;
            }
                .home-update-content h3 a:hover {
                    color: #ea580c;
                }
        .home-update-content p {
            display: -webkit-box;
            margin: 0 0 13px;
            overflow: hidden;
            color: #64748b;
            font-size: 12px;
            line-height: 1.65;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
        }
        .home-update-read-more {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #ea580c;
            font-size: 11px;
            font-weight: 800;
            text-decoration: none;
        }
        .home-updates-empty {
            padding: 55px 20px;
            text-align: center;
            border: 1px dashed #e2e8f0;
            border-radius: 15px;
            background: #fafafa;
        }
        .home-updates-empty-icon {
            width: 50px;
            height: 50px;
            display: grid;
            place-items: center;
            margin: 0 auto 13px;
            color: #fb923c;
            border-radius: 14px;
            background: #fff7ed;
        }
            .home-updates-empty-icon svg {
                width: 25px;
                height: 25px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.5;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
        .home-updates-empty h3 {
            margin: 0 0 5px;
            color: var(--home-ink);
            font-size: 17px;
        }
        .home-updates-empty p {
            margin: 0;
            color: #94a3b8;
            font-size: 12px;
        }
        /* New community / Facebook section */
        .home-community {
            position: relative;
            overflow: hidden;
            background: #f8fafc;
        }
        .home-community-card {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0,1fr) 330px;
            gap: 40px;
            align-items: center;
            padding: 38px 42px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            border-radius: 22px;
            background: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.06);
        }
            .home-community-card::after {
                content: "";
                position: absolute;
                width: 260px;
                height: 260px;
                right: -100px;
                top: -120px;
                border: 45px solid rgba(249,115,22,.055);
                border-radius: 50%;
            }
        .home-community-copy {
            position: relative;
            z-index: 1;
        }
            .home-community-copy h2 {
                max-width: 650px;
                margin: 9px 0 10px;
                color: var(--home-ink);
                font-size: clamp(27px,3.5vw,40px);
                line-height: 1.1;
                letter-spacing: -.03em;
            }
            .home-community-copy p {
                max-width: 630px;
                margin: 0;
                color: #64748b;
                font-size: 14px;
                line-height: 1.75;
            }
        .home-facebook-button {
            position: relative;
            z-index: 2;
            min-height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 0 22px;
            border-radius: 12px;
            color: #fff;
            background: #1877f2;
            text-decoration: none;
            box-shadow: 0 13px 28px rgba(24,119,242,.18);
            transition: transform .2s ease, box-shadow .2s ease;
        }
            .home-facebook-button:hover {
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 17px 32px rgba(24,119,242,.25);
            }
        .home-facebook-icon {
            width: 31px;
            height: 31px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
        }
            .home-facebook-icon svg {
                width: 18px;
                height: 18px;
                fill: currentColor;
                stroke: none;
            }
        .home-facebook-button strong,
        .home-facebook-button small {
            display: block;
            text-align: left;
        }
        .home-facebook-button strong {
            font-size: 13px;
        }
        .home-facebook-button small {
            margin-top: 2px;
            opacity: .8;
            font-size: 9px;
            font-weight: 600;
        }
        /* CTA */
        .home-donation-cta {
            padding: 82px 0;
            background: #fff;
        }
        .home-donation-card {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 35px;
            overflow: hidden;
            padding: 42px 46px;
            border-radius: 24px;
            color: #fff;
            background: linear-gradient(120deg,#c2410c,#ea580c 55%,#f97316);
            box-shadow: 0 20px 50px rgba(194,65,12,.18);
        }
            .home-donation-card::before {
                content: "";
                position: absolute;
                width: 300px;
                height: 300px;
                right: -80px;
                top: -160px;
                border: 50px solid rgba(255,255,255,.08);
                border-radius: 50%;
            }
        .home-donation-content {
            position: relative;
            z-index: 1;
            max-width: 720px;
        }
            .home-donation-content .home-section-eyebrow {
                color: #fed7aa;
            }
            .home-donation-content h2 {
                margin: 10px 0 9px;
