@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const valueCards =
                document.querySelectorAll(".home-value-card");
            const detail =
                document.getElementById("homeValueDetail");
            if (!valueCards.length || !detail) {
                return;
            }
            const valueContent = {
                mission: {
                    title: "Our Mission",
                    text: "To serve with compassion and transform generosity into meaningful action."
                },
                community: {
                    title: "Our Community",
                    text: "People are at the heart of everything we do. Together, we can build a stronger and more caring community."
                },
                impact: {
                    title: "Our Impact",
                    text: "We aim to turn every act of generosity into purposeful support for people and communities."
                }
            };
            valueCards.forEach(function (card) {
                card.addEventListener("click", function () {
                    const value =
                        card.getAttribute("data-value");
                    const content =
                        valueContent[value];
                    if (!content) {
                        return;
                    }
                    valueCards.forEach(function (item) {
                        item.classList.remove("is-active");
                    });
                    card.classList.add("is-active");
                    detail.classList.add("is-changing");
                    window.setTimeout(function () {
                        const label =
                            detail.querySelector(".home-detail-label");
                        const paragraph =
                            detail.querySelector("p");
                        if (label) {
                            label.textContent = content.title;
                        }
                        if (paragraph) {
                            paragraph.textContent = content.text;
                        }
                        detail.classList.remove("is-changing");
                    }, 140);
                });
            });
        });
    </script>
}
