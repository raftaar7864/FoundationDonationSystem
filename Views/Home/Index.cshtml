            .home-donation-circle svg {
                width: 53px;
                height: 53px;
                fill: none;
                stroke: #fff;
                stroke-width: 1.4;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
        /* Contact */
        .home-contact-strip {
            padding: 28px 0;
            background: #172033;
        }
        .home-contact-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }
            .home-contact-content .home-section-eyebrow {
                color: #fb923c;
            }
            .home-contact-content h2 {
                margin: 5px 0 3px;
                color: #fff;
                font-size: 23px;
            }
            .home-contact-content p {
                margin: 0;
                color: #94a3b8;
                font-size: 11px;
            }
        .home-contact-button {
            flex: 0 0 auto;
            color: #fff;
            background: #f97316;
        }
        /* Responsive */
        @@media (max-width:1000px) {
            .home-hero-container {
                grid-template-columns: 1fr;
                gap: 25px;
                padding-top: 55px;
            }
            .home-hero-content {
                max-width: 760px;
                margin: 0 auto;
                text-align: center;
            }
            .home-hero-actions,
            .home-trust-note {
                justify-content: center;
            }
            .home-hero-visual {
                min-height: 320px;
            }
            .home-orbit-two {
                width: 410px;
                height: 410px;
            }
            .home-intro-grid {
                grid-template-columns: 1fr;
                gap: 35px;
            }
            .home-updates-grid {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }
            .home-community-card {
                grid-template-columns: 1fr;
            }
            .home-facebook-button {
                max-width: 340px;
            }
        }
        @@media (max-width:760px) {
            .home-container {
                width: min(100% - 28px,1180px);
            }
            .home-hero {
                min-height: auto;
            }
            .home-hero-container {
                padding: 50px 0 75px;
            }
            .home-hero-title {
                font-size: clamp(38px,11vw,58px);
            }
            .home-hero-description {
                font-size: 14px;
            }
            .home-hero-visual {
                min-height: 270px;
            }
            .home-hero-card {
                width: min(350px,88%);
                padding: 24px;
            }
            .home-orbit-one {
                width: 290px;
                height: 290px;
            }
            .home-orbit-two {
                width: 350px;
                height: 350px;
            }
            .home-intro,
            .home-how-it-works,
            .home-updates,
            .home-community,
            .home-donation-cta {
                padding: 62px 0;
            }
            .home-process {
                grid-template-columns: 1fr;
                gap: 25px;
            }
            .home-process-line {
                width: 1px;
                height: 35px;
                margin: 0 auto;
            }
            .home-updates-header {
                display: block;
                margin-bottom: 25px;
            }
            .home-updates-view-all {
                margin-top: 15px;
            }
            .home-updates-grid {
                grid-template-columns: 1fr;
            }
            .home-community-card {
                padding: 27px 23px;
            }
            .home-donation-card {
                display: block;
                padding: 32px 25px;
            }
            .home-donation-symbol {
                display: none;
            }
            .home-contact-content {
                align-items: flex-start;
                flex-direction: column;
            }
            .home-contact-button {
                width: 100%;
            }
            .home-scroll-indicator {
                display: none;
            }
        }
        @@media (max-width:480px) {
            .home-hero-actions {
                flex-direction: column;
            }
            .home-primary-button,
            .home-secondary-button,
            .home-outline-button {
                width: 100%;
            }
            .home-intro-main {
                padding-left: 48px;
            }
            .home-value-card {
                grid-template-columns: 38px minmax(0,1fr) 16px;
                gap: 9px;
            }
            .home-value-icon {
                width: 38px;
                height: 38px;
            }
            .home-community-copy h2 {
                font-size: 29px;
            }
            .home-facebook-button {
                width: 100%;
            }
            .home-donation-actions {
                flex-direction: column;
            }
        }
    </style>
}
